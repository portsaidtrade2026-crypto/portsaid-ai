{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PORTSAID catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "languages",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "languages": {
      "const": [
        "ar",
        "tr",
        "en",
        "bg"
      ]
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "category",
          "image",
          "image_filename",
          "translations",
          "publish_status",
          "record_type",
          "price",
          "currency",
          "stock_qty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "category": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "image_filename": {
            "type": "string"
          },
          "publish_status": {
            "enum": [
              "ready",
              "review"
            ]
          },
          "record_type": {
            "enum": [
              "product",
              "product_line",
              "service"
            ]
          },
          "price": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "stock_qty": {
            "type": [
              "number",
              "null"
            ]
          },
          "translations": {
            "type": "object",
            "required": [
              "ar",
              "tr",
              "en",
              "bg"
            ],
            "properties": {
              "ar": {
                "type": "object",
                "required": [
                  "name",
                  "short_description",
                  "description",
                  "specifications",
                  "uses",
                  "image_alt"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "short_description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "image_alt": {
                    "type": "string"
                  },
                  "specifications": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "label",
                        "value"
                      ],
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "tr": {
                "type": "object",
                "required": [
                  "name",
                  "short_description",
                  "description",
                  "specifications",
                  "uses",
                  "image_alt"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "short_description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "image_alt": {
                    "type": "string"
                  },
                  "specifications": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "label",
                        "value"
                      ],
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "en": {
                "type": "object",
                "required": [
                  "name",
                  "short_description",
                  "description",
                  "specifications",
                  "uses",
                  "image_alt"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "short_description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "image_alt": {
                    "type": "string"
                  },
                  "specifications": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "label",
                        "value"
                      ],
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "bg": {
                "type": "object",
                "required": [
                  "name",
                  "short_description",
                  "description",
                  "specifications",
                  "uses",
                  "image_alt"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "short_description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "image_alt": {
                    "type": "string"
                  },
                  "specifications": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "label",
                        "value"
                      ],
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}