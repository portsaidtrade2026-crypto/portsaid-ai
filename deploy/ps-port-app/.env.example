# Server-side environment for the PS PORT app. Copy to /opt/ps-port-app/.env (chmod 600). Never commit the real file.
# The variable list is exactly the one in the app's MIGRATION.md / PORTABILITY_AUDIT.md (audit 2026-10-18).

# Medusa. The app and Medusa run on the same Docker network, so use the internal address (no internet hop).
# Fallback if the app ever runs somewhere else: https://admin.portsaid.com.tr
MEDUSA_BACKEND_URL=http://medusa:9000

# Public store key (not a secret; it is also in the website's own JavaScript). Read it on the server with:
#   docker exec portsaid-storefront-1 printenv NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_REPLACE_WITH_THE_STORE_KEY

# Public address of the app (used for absolute links and cookies behind Caddy).
APP_BASE_URL=https://app.portsaid.com.tr

PORT=3000

# Hosts the product photos may come from (the Store API returns https://portsaid.com.tr/static/...).
IMAGE_HOSTS=portsaid.com.tr,admin.portsaid.com.tr

# Company contact card (company number only, never a personal number). The WhatsApp button hides when empty.
CONTACT_PHONE=+902128750605
CONTACT_WHATSAPP=902128750605
